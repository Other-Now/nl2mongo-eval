{"question": "How many movies are rated PG-13?", "collection": "movies", "pipeline": [{"$match": {"rated": "PG-13"}}, {"$count": "n"}]}
{"question": "List the titles of movies from 1994 with an IMDb rating above 8.5, best first.", "collection": "movies", "pipeline": [{"$match": {"year": 1994, "imdb.rating": {"$gt": 8.5}}}, {"$sort": {"imdb.rating": -1}}, {"$project": {"_id": 0, "title": 1, "rating": "$imdb.rating"}}]}
{"question": "Which 3 countries produced the most movies?", "collection": "movies", "pipeline": [{"$unwind": "$countries"}, {"$group": {"_id": "$countries", "n": {"$sum": 1}}}, {"$sort": {"n": -1}}, {"$limit": 3}]}
{"question": "How many theaters are there in New York state?", "collection": "theaters", "pipeline": [{"$match": {"location.address.state": "NY"}}, {"$count": "n"}]}
{"question": "Show the 5 most recent comments on Jaws, with the commenter's name and the date.", "collection": "movies", "pipeline": [{"$match": {"title": "Jaws"}}, {"$lookup": {"from": "comments", "localField": "_id", "foreignField": "movie_id", "as": "c"}}, {"$unwind": "$c"}, {"$sort": {"c.date": -1}}, {"$limit": 5}, {"$project": {"_id": 0, "name": "$c.name", "date": "$c.date"}}]}
{"question": "How many comments were posted in March 2010?", "collection": "comments", "pipeline": [{"$match": {"date": {"$gte": {"$date": "2010-03-01T00:00:00Z"}, "$lt": {"$date": "2010-04-01T00:00:00Z"}}}}, {"$count": "n"}]}
{"question": "How many comments were posted on each day of the week?", "collection": "comments", "pipeline": [{"$group": {"_id": {"$dayOfWeek": "$date"}, "n": {"$sum": 1}}}, {"$sort": {"_id": 1}}]}
{"question": "What is the longest Western, by runtime?", "collection": "movies", "pipeline": [{"$match": {"genres": "Western", "runtime": {"$type": "number"}}}, {"$sort": {"runtime": -1}}, {"$limit": 1}, {"$project": {"_id": 0, "title": 1, "runtime": 1}}]}
{"question": "What is the average number of award nominations for movies from 1995?", "collection": "movies", "pipeline": [{"$match": {"year": 1995}}, {"$group": {"_id": null, "avg": {"$avg": "$awards.nominations"}}}, {"$project": {"_id": 0, "avg": 1}}]}
{"question": "How many movies have no genres listed?", "collection": "movies", "pipeline": [{"$match": {"genres": {"$exists": false}}}, {"$count": "n"}]}
{"question": "Which movies list more than 5 languages?", "collection": "movies", "pipeline": [{"$match": {"$expr": {"$gt": [{"$size": {"$ifNull": ["$languages", []]}}, 5]}}}, {"$project": {"_id": 0, "title": 1}}]}
{"question": "What are the 5 movies with the most IMDb votes?", "collection": "movies", "pipeline": [{"$match": {"imdb.votes": {"$type": "number"}}}, {"$sort": {"imdb.votes": -1}}, {"$limit": 5}, {"$project": {"_id": 0, "title": 1, "votes": "$imdb.votes"}}]}
{"question": "Which commenters have written more than 300 comments?", "collection": "comments", "pipeline": [{"$group": {"_id": "$name", "n": {"$sum": 1}}}, {"$match": {"n": {"$gt": 300}}}, {"$sort": {"n": -1}}]}
{"question": "How many comments were posted in each year from 2010 to 2015?", "collection": "comments", "pipeline": [{"$match": {"date": {"$gte": {"$date": "2010-01-01T00:00:00Z"}, "$lt": {"$date": "2016-01-01T00:00:00Z"}}}}, {"$group": {"_id": {"$year": "$date"}, "n": {"$sum": 1}}}, {"$sort": {"_id": 1}}]}
{"question": "What is the theaterId of each theater in Chicago?", "collection": "theaters", "pipeline": [{"$match": {"location.address.city": "Chicago"}}, {"$project": {"_id": 0, "theaterId": 1}}]}
{"question": "How many movies were produced by Warner Bros. Pictures, according to Rotten Tomatoes?", "collection": "movies", "pipeline": [{"$match": {"tomatoes.production": "Warner Bros. Pictures"}}, {"$count": "n"}]}
{"question": "How many comments does each Steven Spielberg movie have?", "collection": "movies", "pipeline": [{"$match": {"directors": "Steven Spielberg"}}, {"$lookup": {"from": "comments", "localField": "_id", "foreignField": "movie_id", "as": "c"}}, {"$project": {"_id": 0, "title": 1, "n": {"$size": "$c"}}}]}
{"question": "Which genres do Keanu Reeves movies belong to, and how many of his movies are in each?", "collection": "movies", "pipeline": [{"$match": {"cast": "Keanu Reeves"}}, {"$unwind": "$genres"}, {"$group": {"_id": "$genres", "n": {"$sum": 1}}}, {"$sort": {"n": -1}}]}
{"question": "When was the earliest comment posted?", "collection": "comments", "pipeline": [{"$sort": {"date": 1}}, {"$limit": 1}, {"$project": {"_id": 0, "date": 1}}]}
{"question": "What was the box office gross of each theater last year?", "answerable": false, "reason": "theaters holds only locations; there is no sales or box office data per theater"}
