{"id": "F01", "category": "filter", "question": "How many movies were directed by Christopher Nolan?", "collection": "movies", "pipeline": [{"$match": {"directors": "Christopher Nolan"}}, {"$count": "n"}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "F02", "category": "filter", "question": "How many movies have an IMDb rating of at least 9.0 and more than 100,000 IMDb votes?", "collection": "movies", "pipeline": [{"$match": {"imdb.rating": {"$gte": 9}, "imdb.votes": {"$gt": 100000}}}, {"$count": "n"}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "F03", "category": "filter", "question": "How many theaters are in California?", "collection": "theaters", "pipeline": [{"$match": {"location.address.state": "CA"}}, {"$count": "n"}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "F04", "category": "filter", "question": "Which movies feature both Tom Hanks and Meg Ryan in the cast? Give the titles.", "collection": "movies", "pipeline": [{"$match": {"cast": {"$all": ["Tom Hanks", "Meg Ryan"]}}}, {"$project": {"_id": 0, "title": 1}}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "F05", "category": "filter", "question": "How many movies have a runtime longer than 240 minutes?", "collection": "movies", "pipeline": [{"$match": {"runtime": {"$gt": 240}}}, {"$count": "n"}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "F06", "category": "filter", "question": "Which movies have a Metacritic score of 100? List their titles.", "collection": "movies", "pipeline": [{"$match": {"metacritic": 100}}, {"$project": {"_id": 0, "title": 1}}], "ordered": false, "answerable": true, "expect_rows": 11}
{"id": "F07", "category": "filter", "question": "How many comments has the user named Ned Stark written?", "collection": "comments", "pipeline": [{"$match": {"name": "Ned Stark"}}, {"$count": "n"}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "F08", "category": "filter", "question": "What is the title of the movie whose IMDb id is 133093?", "collection": "movies", "pipeline": [{"$match": {"imdb.id": 133093}}, {"$project": {"_id": 0, "title": 1}}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "F09", "category": "filter", "question": "How many series (not movies) are there in the collection?", "collection": "movies", "pipeline": [{"$match": {"type": "series"}}, {"$count": "n"}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "F10", "category": "filter", "question": "How many movies are rated PG and belong to the Animation genre?", "collection": "movies", "pipeline": [{"$match": {"rated": "PG", "genres": "Animation"}}, {"$count": "n"}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "G01", "category": "group", "question": "Which 5 genres have the most movies, and how many movies does each have?", "collection": "movies", "pipeline": [{"$unwind": "$genres"}, {"$group": {"_id": "$genres", "n": {"$sum": 1}}}, {"$sort": {"n": -1}}, {"$limit": 5}], "ordered": true, "answerable": true, "expect_rows": 5}
{"id": "G02", "category": "group", "question": "What is the average IMDb rating of Horror movies?", "collection": "movies", "pipeline": [{"$match": {"genres": "Horror", "imdb.rating": {"$type": "number"}}}, {"$group": {"_id": null, "avg": {"$avg": "$imdb.rating"}}}, {"$project": {"_id": 0, "avg": 1}}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "G03", "category": "group", "question": "Which director has directed the most movies in the collection? Give the name and the number of movies.", "collection": "movies", "pipeline": [{"$unwind": "$directors"}, {"$group": {"_id": "$directors", "n": {"$sum": 1}}}, {"$sort": {"n": -1}}, {"$limit": 1}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "G04", "category": "group", "question": "How many distinct countries appear across all movies?", "collection": "movies", "pipeline": [{"$unwind": "$countries"}, {"$group": {"_id": "$countries"}}, {"$count": "n"}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "G05", "category": "group", "question": "How many movies were made in each decade from the 1980s to the 2010s, based on the year field? Give each decade (e.g. 1980) and its count.", "collection": "movies", "pipeline": [{"$match": {"year": {"$type": "number", "$gte": 1980, "$lt": 2020}}}, {"$group": {"_id": {"$subtract": ["$year", {"$mod": ["$year", 10]}]}, "n": {"$sum": 1}}}], "ordered": false, "answerable": true, "expect_rows": 4}
{"id": "G06", "category": "group", "question": "What is the average runtime for each type (movie and series)?", "collection": "movies", "pipeline": [{"$group": {"_id": "$type", "avg": {"$avg": "$runtime"}}}], "ordered": false, "answerable": true, "expect_rows": 2}
{"id": "G07", "category": "group", "question": "Which 2 actors appear in the most movies that have an IMDb rating of 8 or higher? Give each name and count.", "collection": "movies", "pipeline": [{"$match": {"imdb.rating": {"$gte": 8}}}, {"$unwind": "$cast"}, {"$group": {"_id": "$cast", "n": {"$sum": 1}}}, {"$sort": {"n": -1}}, {"$limit": 2}], "ordered": true, "answerable": true, "expect_rows": 2}
{"id": "G08", "category": "group", "question": "Which movie has won the most awards, and how many wins does it have?", "collection": "movies", "pipeline": [{"$sort": {"awards.wins": -1}}, {"$limit": 1}, {"$project": {"_id": 0, "title": 1, "wins": "$awards.wins"}}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "G09", "category": "group", "question": "What is the average number of IMDb votes for movies rated R?", "collection": "movies", "pipeline": [{"$match": {"rated": "R", "imdb.votes": {"$type": "number"}}}, {"$group": {"_id": null, "avg": {"$avg": "$imdb.votes"}}}, {"$project": {"_id": 0, "avg": 1}}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "G10", "category": "group", "question": "How many movies are there for each MPAA rating among G, PG, PG-13 and R?", "collection": "movies", "pipeline": [{"$match": {"rated": {"$in": ["G", "PG", "PG-13", "R"]}}}, {"$group": {"_id": "$rated", "n": {"$sum": 1}}}], "ordered": false, "answerable": true, "expect_rows": 4}
{"id": "J01", "category": "join", "question": "Which movie has the most comments in the comments collection? Give its title and the number of comments.", "collection": "comments", "pipeline": [{"$group": {"_id": "$movie_id", "n": {"$sum": 1}}}, {"$sort": {"n": -1}}, {"$limit": 1}, {"$lookup": {"from": "movies", "localField": "_id", "foreignField": "_id", "as": "m"}}, {"$project": {"_id": 0, "title": {"$first": "$m.title"}, "n": 1}}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "J02", "category": "join", "question": "What is the title of the movie that Mercedes Tyler commented on most recently?", "collection": "comments", "pipeline": [{"$match": {"name": "Mercedes Tyler"}}, {"$sort": {"date": -1}}, {"$limit": 1}, {"$lookup": {"from": "movies", "localField": "movie_id", "foreignField": "_id", "as": "m"}}, {"$project": {"_id": 0, "title": {"$first": "$m.title"}}}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "J03", "category": "join", "question": "How many comments have been posted on movies directed by Quentin Tarantino?", "collection": "movies", "pipeline": [{"$match": {"directors": "Quentin Tarantino"}}, {"$lookup": {"from": "comments", "localField": "_id", "foreignField": "movie_id", "as": "c"}}, {"$group": {"_id": null, "n": {"$sum": {"$size": "$c"}}}}, {"$project": {"_id": 0, "n": 1}}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "J04", "category": "join", "question": "Which genre has received the most comments overall? Give the genre and the comment count.", "collection": "comments", "pipeline": [{"$lookup": {"from": "movies", "localField": "movie_id", "foreignField": "_id", "as": "m"}}, {"$unwind": "$m"}, {"$unwind": "$m.genres"}, {"$group": {"_id": "$m.genres", "n": {"$sum": 1}}}, {"$sort": {"n": -1}}, {"$limit": 1}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "J05", "category": "join", "question": "How many distinct people (by email) have commented on The Godfather?", "collection": "movies", "pipeline": [{"$match": {"title": "The Godfather"}}, {"$lookup": {"from": "comments", "localField": "_id", "foreignField": "movie_id", "as": "c"}}, {"$unwind": "$c"}, {"$group": {"_id": "$c.email"}}, {"$count": "n"}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "J06", "category": "join", "question": "How many comments were written by people who also have an account in the users collection (matched by email)?", "collection": "comments", "pipeline": [{"$lookup": {"from": "users", "localField": "email", "foreignField": "email", "as": "u"}}, {"$match": {"u.0": {"$exists": true}}}, {"$count": "n"}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "J07", "category": "join", "question": "How many comments are there on the 1997 movie Titanic?", "collection": "movies", "pipeline": [{"$match": {"title": "Titanic", "year": 1997}}, {"$lookup": {"from": "comments", "localField": "_id", "foreignField": "movie_id", "as": "c"}}, {"$project": {"_id": 0, "n": {"$size": "$c"}}}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "J08", "category": "join", "question": "What is the average IMDb rating of the movies Ned Stark has commented on (count each movie once)?", "collection": "comments", "pipeline": [{"$match": {"name": "Ned Stark"}}, {"$group": {"_id": "$movie_id"}}, {"$lookup": {"from": "movies", "localField": "_id", "foreignField": "_id", "as": "m"}}, {"$unwind": "$m"}, {"$match": {"m.imdb.rating": {"$type": "number"}}}, {"$group": {"_id": null, "avg": {"$avg": "$m.imdb.rating"}}}, {"$project": {"_id": 0, "avg": 1}}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "D01", "category": "date", "question": "How many comments were posted in 2012?", "collection": "comments", "pipeline": [{"$match": {"date": {"$gte": {"$date": "2012-01-01T00:00:00Z"}, "$lt": {"$date": "2013-01-01T00:00:00Z"}}}}, {"$count": "n"}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "D02", "category": "date", "question": "In which calendar month (1-12) have the most comments been posted, across all years? Give the month and the count.", "collection": "comments", "pipeline": [{"$group": {"_id": {"$month": "$date"}, "n": {"$sum": 1}}}, {"$sort": {"n": -1}}, {"$limit": 1}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "D03", "category": "date", "question": "How many movies were released on December 25 (of any year), according to the release date?", "collection": "movies", "pipeline": [{"$match": {"released": {"$type": "date"}}}, {"$match": {"$expr": {"$and": [{"$eq": [{"$month": "$released"}, 12]}, {"$eq": [{"$dayOfMonth": "$released"}, 25]}]}}}, {"$count": "n"}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "D04", "category": "date", "question": "Which movie has the earliest release date, and what is that date?", "collection": "movies", "pipeline": [{"$match": {"released": {"$type": "date"}}}, {"$sort": {"released": 1}}, {"$limit": 1}, {"$project": {"_id": 0, "title": 1, "released": 1}}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "D05", "category": "date", "question": "How many comments were posted on a Saturday or a Sunday?", "collection": "comments", "pipeline": [{"$match": {"$expr": {"$in": [{"$dayOfWeek": "$date"}, [1, 7]]}}}, {"$count": "n"}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "D06", "category": "date", "question": "How many movies were released between 1 January 2000 and 31 December 2004 inclusive, by release date?", "collection": "movies", "pipeline": [{"$match": {"released": {"$gte": {"$date": "2000-01-01T00:00:00Z"}, "$lt": {"$date": "2005-01-01T00:00:00Z"}}}}, {"$count": "n"}], "ordered": false, "answerable": true, "expect_rows": 1}
{"id": "D07", "category": "date", "question": "Which year saw the most comments posted? Give the year and the number of comments.", "collection": "comments", "pipeline": [{"$group": {"_id": {"$year": "$date"}, "n": {"$sum": 1}}}, {"$sort": {"n": -1}}, {"$limit": 1}], "ordered": false, "answerable": true, "expect_rows": 1}
